# Optional Python bridge override; app.py defaults to windops.backend.
WINDOPS_BACKEND_MODULE=
# Optional config file; defaults to config.local.json. Loaded as JSON, never code.
WINDOPS_CONFIG=
# Optional real artifact for an integration smoke test. No dataset is bundled.
WINDOPS_SMOKE_BUNDLE=
# Backend data folder, defaults to data/ in this repository.
WINDOPS_DATA_DIR=
# Participant 1 Python module, see docs/BACKEND.md.
WINDOPS_ML_MODULE=
# auto / agent / deterministic. auto explicitly reports deterministic fallback.
WINDOPS_EXECUTION_MODE=
# Set 1 to prohibit weather network access and require the verified local cache.
WINDOPS_OFFLINE=
OPENAI_API_KEY=
OPENAI_MODEL=
